PORT=4000
CORS_ORIGIN=http://localhost:3000
CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# OPTION A: Cloud Setup (Neon PostgreSQL + Upstash Redis)
# -----------------------------------------------------------------------------
# Neon Pooled connection (used by the running Express app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon Direct connection (used by Prisma CLI for running migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Upstash Redis TLS connection string (rediss:// scheme)
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# -----------------------------------------------------------------------------
# OPTION B: Local Docker Setup (docker-compose.yml at workspace root)
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dams"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dams"
# REDIS_URL="redis://localhost:6379"
